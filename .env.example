# docker compose reads ./.env. Copy this file to .env (git-ignored) and replace every value.
# SQL Server rule: at least 8 characters with upper case, lower case, a digit and a symbol.
MSSQL_SA_PASSWORD=Change-Me-Str0ng!
# At least 32 random characters, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters-0000
# Optional: the first admin account (created only while no admin exists). Remove after the first start.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Change-Me-Adm1n!
